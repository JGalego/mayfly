{
  "name": "mayfly",
  "displayName": "Mayfly",
  "description": "Describe a small app. Mayfly builds it and runs it on your machine, behind sign-in.",
  "version": "0.1.0",
  "icon": "icon.png",
  "publisher": "jgalego",
  "license": "AGPL-3.0-only",
  "engines": {
    "podman-desktop": ">=1.26.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mayfly.open",
        "title": "Mayfly: Make an app"
      }
    ],
    "configuration": {
      "title": "Mayfly",
      "properties": {
        "mayfly.developerMode": {
          "type": "boolean",
          "default": false,
          "description": "Show code, version history, app health, logs and model usage"
        }
      }
    }
  }
}
