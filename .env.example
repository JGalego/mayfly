# Copy to .env and fill in. .env is git-ignored.
# Mayfly talks to one OpenAI-compatible endpoint, with your own key. OpenAI is the default.

MAYFLY_MODEL_BASE_URL=https://api.openai.com/v1
MAYFLY_MODEL_API_KEY=sk-proj-...
MAYFLY_MODEL=gpt-6.2-astra

# Other endpoints (set MAYFLY_MODEL to that provider's model id):
# MAYFLY_MODEL_BASE_URL=https://api.anthropic.com/v1/
# MAYFLY_MODEL_BASE_URL=https://openrouter.ai/api/v1
# MAYFLY_MODEL_BASE_URL=http://localhost:11434/v1   # Ollama; any non-empty key works
