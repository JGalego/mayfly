{
  "name": "mayfly",
  "version": "0.0.0",
  "private": true,
  "description": "Describe a small app; get it running on your machine behind sign-in, built to a fixed contract.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\" \"runtime/src/**/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build:runtime": "runtime/build.sh",
    "build:extension": "node src/shells/podman-desktop/build.ts"
  },
  "devDependencies": {
    "@podman-desktop/api": "1.31.0",
    "@types/node": "24.19.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "openai": "7.65.0"
  }
}
