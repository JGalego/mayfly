# The runtime every generated app starts from: Node 24 on a Wolfi base with no shell or package manager,
# plus Mayfly's fixed code. A generated app adds one file, /app/routes.ts. Build it with build.sh.
# The base is a list of its amd64 and arm64 images, and each build takes the one for its --platform.
FROM localhost/mayfly-runtime-base@sha256:20b959ad5960230b65a77b746bdbf5d991ade4d7a129c2554e167acdcc990531

ARG REVISION
LABEL org.opencontainers.image.title="mayfly-runtime" \
      org.opencontainers.image.description="Node 24 runtime for Mayfly apps: sign-in identity, a store, JSON logs, health checks" \
      org.opencontainers.image.source="https://github.com/JGalego/mayfly" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /app
COPY package.json ./
COPY node_modules ./node_modules
COPY src ./runtime
USER 65532:65532
ENTRYPOINT ["/usr/bin/node", "/app/runtime/server.ts"]
